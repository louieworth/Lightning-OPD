# Copy to the repository root as .env when setting up a new checkout.
# Both YAML launchers and sync_wandb.sh load the root .env automatically.
# Keep real API keys in .env only; do not commit them in this template or YAML.
WANDB_API_KEY=
WANDB_ENTITY=li-jiang-opd
WANDB_MODE=offline
# Training mode, project and entity are configured in configs/config/*.yaml.
# Default project_name for SFT, OPD and Lightning OPD: onestep-opd.
